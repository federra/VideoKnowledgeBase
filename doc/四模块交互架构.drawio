        <mxCell id="library_nav" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E9F5EE;strokeColor=none;fontColor=#17324D;fontFamily=Helvetica;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=14;shadow=0;" value="&lt;div style=&quot;line-height:1.45&quot;&gt;知识浏览 · 入库处理 · 审核队列 · 回收站&lt;/div&gt;" vertex="1">
