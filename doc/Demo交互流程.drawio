          <mxGeometry as="geometry" x="1025" y="680" width="390" height="140" />
        </mxCell>
        <mxCell id="W07" value="W07  选择集数／材料版本&#10;同集多版本归组；未标集单列；超过100集按段导航" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff7d6;strokeColor=#baa457;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;shape=rhombus;rounded=0;align=center;spacing=5;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="905" width="390" height="140" />
        </mxCell>
        <mxCell id="W08" value="W08  缺集空态&#10;可选择缺集；补充该集资料自动带入集号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#eaf5ef;strokeColor=#81ab94;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="905" width="390" height="140" />
