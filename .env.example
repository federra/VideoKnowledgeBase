# Copy to .env in the repository root. Local development values only.
APP_NAME=content-intelligence-api
# This project uses an isolated Colima profile; use default for Docker Desktop.
CIP_DOCKER_CONTEXT=colima-cip-local
POSTGRES_DB=content_intelligence
POSTGRES_USER=content_intelligence
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=15432
REDIS_PORT=16379
DATABASE_URL=postgresql+psycopg://content_intelligence:local-development-only@127.0.0.1:15432/content_intelligence
REDIS_URL=redis://127.0.0.1:16379/0
STORAGE_ROOT=../data
# S01: private server-side credential; never put this in VITE_* or commit a real value.
REDFOX_API_KEY=

# S04: optional migration owner override; DATABASE_URL remains the local owner fallback.
# MIGRATION_DATABASE_URL=
# Run pnpm db:app-role after migration; it appends a restricted private login to .env.
# APPLICATION_DATABASE_URL must never reuse the migration owner's credentials.
APPLICATION_DATABASE_URL=

# S05.2: exact trusted browser origins (JSON), no wildcard; API cookie stays HttpOnly.
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Local HTTP is allowed only on localhost/127.0.0.1; HTTPS deployment must set true.
SECURE_COOKIES=false

# S05.3: STORAGE_ROOT/files is private; relative paths are resolved from backend/.
# MAX_FILE_BYTES must be 1..268435456 (default 50 MiB).
MAX_FILE_BYTES=52428800
# Exact lowercase trusted direct-media HTTPS hostnames; empty disables external fetch.
EXTERNAL_MEDIA_HOSTS=[]

# S05.4: private Redis broker; share these values across Beat and workers.
TASK_QUEUE=cip.tasks.v1
TASK_KEY_PREFIX=cip:v1:

# 本机单人开发：无需手动登录；默认关闭，部署时保持 false。
LOCAL_SINGLE_USER=false

# S06.4 DeepSeek 服务端密钥；兼容用户现有 deepseek_key 字段，勿写入前端。
deepseek_key=

# 评论首采专用服务端密钥；不得用于前端或打印请求 URL。
TIKHUB_API_KEY=
