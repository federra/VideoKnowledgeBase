        <mxCell id="T01" value="T01  选题卡 #0/1&#10;按业务展示候选卡；漫剧评分在左上角；9张／页" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#edf3ff;strokeColor=#7598c7;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="230" width="390" height="140" />
        </mxCell>
        <mxCell id="T02" value="T02  新增选题&#10;人工新建并保存候选；闪念独立记录，见闪念与头脑风暴页" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff3e8;strokeColor=#ce9b66;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="230" width="390" height="140" />
        </mxCell>
        <mxCell id="T03" value="T03  AI再来5个&#10;漫剧／故事短片新增5张固定样例；电商流程暂缓" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#eaf5ef;strokeColor=#81ab94;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1025" y="230" width="390" height="140" />
        </mxCell>
        <mxCell id="T04" value="T04  统一选题详情抽屉&#10;点卡片／标题／评分／编辑均打开此处" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#f1edff;strokeColor=#9982bd;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="455" width="390" height="140" />
        </mxCell>
        <mxCell id="T05" value="T05  人工编辑&#10;标题、业务、受众、Logline、单框角色设定、全局节奏" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff3e8;strokeColor=#ce9b66;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="455" width="390" height="140" />
        </mxCell>
        <mxCell id="T06" value="T06  承重力评估&#10;漫剧内容5维＋市场5维，每维5分；总分50；读取当前版本评分" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#f1edff;strokeColor=#9982bd;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1025" y="455" width="390" height="140" />
        </mxCell>
        <mxCell id="T07" value="T07  有实质改动？&#10;改回原内容视为无改动；保存并重新评分据此启用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff7d6;strokeColor=#baa457;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;shape=rhombus;rounded=0;align=center;spacing=5;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="680" width="390" height="140" />
        </mxCell>
        <mxCell id="T08" value="T08  未修改&#10;保存并重新评分灰色禁用；仍可独立确认入待生产" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#eaf5ef;strokeColor=#81ab94;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="680" width="390" height="140" />
        </mxCell>
        <mxCell id="T09" value="T09  保存新版本&#10;旧内容及评分入历史；新版本生成待评分请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#eaf5ef;strokeColor=#81ab94;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="905" width="390" height="140" />
        </mxCell>
        <mxCell id="T10" value="T10  AI重评未接入&#10;保持待评分；不生成替代分数" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#f4f4f5;strokeColor=#9b9da3;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1130" width="390" height="140" />
        </mxCell>
        <mxCell id="T11" value="T11  确认加入待生产&#10;要求明确主业务线；不以研判／评分完成为前提" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff7d6;strokeColor=#baa457;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;shape=rhombus;rounded=0;align=center;spacing=5;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1025" y="680" width="390" height="140" />
        </mxCell>
        <mxCell id="T12" value="T12  待生产 #0/2&#10;选题详情与交接；保留同一对象及版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#edf3ff;strokeColor=#7598c7;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
