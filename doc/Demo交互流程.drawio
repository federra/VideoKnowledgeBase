        <mxCell id="K07" value="K07  等待审核／修订候选&#10;新建及实质修订为待AI审核；保存新版本并留旧版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff3e8;strokeColor=#ce9b66;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
