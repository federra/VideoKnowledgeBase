        <mxCell id="n35" value="&lt;div style=&quot;line-height:1.45&quot;&gt;结构化存储&lt;br&gt;PostgreSQL + JSONB&lt;br&gt;知识主体 / 项目 / 关系表&lt;br&gt;版本 / 调用 / 预测 / 评价&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6799D0;fontColor=#17324D;fontFamily=Helvetica;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=12;shadow=0;" vertex="1" parent="1">
