        client_socket,server_socket=socket.socketpair()
        stopped=threading.Event()
        def server():
            try:
                conn=server_socket
                with conn:
                    conn.settimeout(2)
                    request=b''
                    while b'\r\n\r\n' not in request:request+=conn.recv(4096)
                    conn.sendall(b'HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n1;')
                    for _ in range(100):
                        if stopped.wait(.02):break
                        conn.sendall(b'a')
                    conn.sendall(b'\r\nZ\r\n0\r\n\r\n')
            except OSError:pass
            finally:server_socket.close()
        worker=threading.Thread(target=server,daemon=True);worker.start()
        class LocalConnection(http.client.HTTPConnection):
