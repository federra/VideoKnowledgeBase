        <mxCell id="K06" value="K06  AI是否已通过？&#10;读取已有审核结果；没有执行模型审核按钮" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff7d6;strokeColor=#baa457;fontColor=#263445;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;shape=rhombus;rounded=0;align=center;spacing=5;fontSize=14;" vertex="1" parent="1">
